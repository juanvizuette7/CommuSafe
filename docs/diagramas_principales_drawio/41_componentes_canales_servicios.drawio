ll id="dom" value="«component»&#10;Dominio (agrupación lógica)&#10;usuarios · incidentes&#10;notificaciones · asistente&#10;Modelos y reglas de negocio&#10;CommuBot: conocimiento local" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#222222;strokeColor=#444444;fillColor=#eaf4ee;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="960" y="380" width="300" height="210" as="geometry"/></mxCell><mxCell id="db" value="«database»&#10;PostgreSQL · producción&#10;Persistencia relacional" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#222222;strokeColor=#444444;fillColor=#eaf4ee;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="720" y="770" width="290" height="130" as="geometry"/></mxCell><mxCell id="fs" value="«storage»&#10;Archivos multimedia&#10;FileSystemStorage / MEDIA_ROOT" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#222222;strokeColor=#444444;fillColor=#eaf4ee;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="1120" y="800" width="340" height="130" as="geometry"/></mxCell><mxCell id="fcm" value="«component» «external»&#10;Firebase Cloud Messaging&#10;Notificaciones push" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#222222;strokeColor=#444444;fillColor=#eaf4ee;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="300" height="130" as="geometry"/></mxCell><mxCell id="smtp" value="«component» «external»&#10;Servidor SMTP&#10;Recuperación de contraseña" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#222222;strokeColor=#444444;fillColor=#eaf4ee;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="1340" y="230" width="290" height="130" as="geometry"/></mxCell><mxCell id="ia" value="«component» «external»&#10;Proveedor IA · Gemini&#10;Respaldo opcional de CommuBot" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#222222;strokeColor=#444444;fillColor=#eaf4ee;spacing=8;rounded=0;" vertex="1" parent="1"><mxGeometry x="1340" y="600" width="290" height="130" as="geometry"/></mxCell><mxCell id="notes" value="Flechas discontinuas: dependencia de uso hacia el proveedor; no representan el recorrido de una respuesta.&#10;API, vistas y dominio pertenecen al mismo backend Django. El panel no es un servidor independiente.&#10;Persistencia mostrada: producción (SQLite se usa en desarrollo). Las fotografías se almacenan fuera de la base de datos.&#10;CommuBot consulta conocimiento local y puede utilizar Gemini como respaldo generativo." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#222222;strokeColor=#444444;fillColor=#eaf4ee;spacing=8;text;strokeColor=none;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="1600" height="90" as="geometry"/></mxCell><mxCell id="e0" edge="1" parent="1" source="mob" target="api" style="edgeStyle=none;html=0;rounded=0;strokeColor=#444444;endArrow=open;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e0_label" value="HTTPS / REST&#10;JWT" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=none;"><mxGeometry x="290" y="248" width="200" height="44" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="web" target="panel" style="edgeStyle=none;html=0;rounded=0;strokeColor=#444444;endArrow=open;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1_label" value="HTTPS&#10;Sesión / cookies" vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fillColor=#FFFFFF;strokeColor=none;"><mxGeometry x="310" y="588" width="200" height="44" as="geometry"/></mxC